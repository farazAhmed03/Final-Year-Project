# LegalSphere legacy-compatible local/Docker configuration
# Copy to .env, paste your rotated private values, then run:
#   node scripts/setup-env.js --frontend-port 8081
#
# Jenkins can remain on 8080; LegalSphere uses 8081 on the Windows host.

NODE_ENV=production

# Backend port inside Docker. The compose/nginx setup supports this value dynamically.
PORT=3000

# Host ports
FRONTEND_PORT=8081
MAILPIT_PORT=8025

# Database
MONGO_URI=mongodb://mongo:27017/legalsphere

# Browser/CORS URLs
APP_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
PUBLIC_APP_URL=http://localhost:8081
BASE_URL_PASSWORD_RESET=http://localhost:8081

# Legacy names remain supported. setup-env.js replaces weak placeholders.
JWT_SECRET=CHANGE_ME
SESSION_SECRET=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# false for localhost HTTP; true only behind public HTTPS
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Original mail variable names are supported
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=LegalSphere <no-reply@legalsphere.local>

# Private legal-document storage. Do not make this a public static folder.
LOCAL_UPLOAD_PATH=/data/uploads
PRIVATE_UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=10

# Optional Cloudinary credentials (reserved for public profile media only).
# Private legal documents continue to use permission-checked storage.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Optional PayFast legacy configuration. Stripe Checkout is the active payment provider.
MERCHANT_ID=
MERCHANT_KEY=
PAYFAST_URL=https://sandbox.payfast.co.za/eng/process
RETURN_URL=http://localhost:8081/payment/success
CANCEL_URL=http://localhost:8081/payment/cancel

# Stripe Checkout
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Optional monitoring
SENTRY_DSN=

# Optional Firebase/Google login
FIREBASE_SERVICE_ACCOUNT_JSON=
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# Seed account
SEED_ADMIN_EMAIL=admin@legalsphere.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN
